#!/bin/sh
# PID 1 of the live LUKS guest: cryptsetup formats /dev/vda with a volume key it draws itself, opens it through
# dm-crypt and keeps the key linked in root's user keyring (--link-vk-to-keyring). Then it prints the truth and idles.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /run /tmp
exec > /dev/console 2>&1
echo "GUEST_BOOTED $(uname -r)"
for m in virtio_pci virtio_blk dm_crypt ecb xts aesni_intel algif_skcipher; do modprobe $m || echo "modprobe $m failed"; done
echo "TRUTH cryptsetup $(cryptsetup --version)"
for i in 1 2 3 4 5; do [ -b /dev/vda ] || sleep 1; done
[ -b /dev/vda ] || { echo "GUEST_FAILED no /dev/vda"; exec sleep 86400; }
P="correct horse battery staple"
# pbkdf2 with few iterations only because the CPU is emulated; header sizes as in sample/luks/build.sh
printf %s "$P" | cryptsetup luksFormat -q --type luks2 --cipher aes-xts-plain64 --key-size 512 --sector-size 512 \
  --pbkdf pbkdf2 --pbkdf-force-iterations 1000 --luks2-metadata-size 16k --luks2-keyslots-size 256k --offset 2048 \
  /dev/vda - || echo "GUEST_FAILED luksFormat"
T=logon
printf %s "$P" | cryptsetup open --link-vk-to-keyring "@u::%logon:cryptsetup:live-vol" /dev/vda livevol - || {
  T=user
  printf %s "$P" | cryptsetup open --link-vk-to-keyring "@u::%user:cryptsetup:live-vol" /dev/vda livevol - \
    || echo "GUEST_FAILED open"
}
echo "TRUTH keytype $T"
printf 'live-vol sector 0: written through dm-crypt inside the guest\n' | dd of=/dev/mapper/livevol conv=notrunc 2>/dev/null
printf 'live-vol sector 5: second marker\n' | dd of=/dev/mapper/livevol bs=512 seek=5 conv=notrunc 2>/dev/null
sync
cryptsetup status livevol | sed 's/^/TRUTH status /'
# The table names the key dm-crypt took from the keyring; the key bytes are never printed, only their sha256.
dmsetup table livevol | sed 's/^/TRUTH table /'
printf %s "$P" | cryptsetup luksDump -q --dump-volume-key --volume-key-file /tmp/vk.bin --key-file - /dev/vda >/dev/null
echo "TRUTH vk sha256=$(sha256sum /tmp/vk.bin | cut -d' ' -f1) bytes=$(wc -c < /tmp/vk.bin)"
rm -f /tmp/vk.bin
sed 's/^/TRUTH view root /' /proc/keys
echo "GUEST_READY_FOR_DUMP"
while true; do sleep 3600; done
